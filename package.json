{
  "name": "acik-teklif-pazari",
  "private": true,
  "version": "0.1.0",
  "description": "Cloudflare Worker + D1 tabanli ihale sitesi",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local --persist-to %TEMP%\\wrangler-persist",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create acik-teklif-pazari-db",
    "migrate:local": "wrangler d1 migrations apply acik-teklif-pazari-db --local",
    "migrate:local:persist": "wrangler d1 migrations apply acik-teklif-pazari-db --local --persist-to %TEMP%\\wrangler-persist",
    "migrate:remote": "wrangler d1 migrations apply acik-teklif-pazari-db --remote",
    "whoami": "wrangler whoami"
  }
}
